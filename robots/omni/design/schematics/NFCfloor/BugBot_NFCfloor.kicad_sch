	(paper "A4")
	(title_block
		(title "BugBot NFC floor PCB: antenna loop + reader + underglow")
		(rev "1")
		(comment 1 "JLC 2-layer FR4 1.6 mm, parts on the bottom only; screwed under the floor plate by the 3 nylon clamp screws (M2 x 5)")
		(comment 2 "3-turn loop 0.18 / 0.15 round the edge (top copper); its two ends into the reader's matching (both on net COIL: the loop is copper)")
		(comment 3 "J1 = 12 plated solder holes: 1 RST 2 MISO 3 SCK 4 MOSI 5 GND 6 NSS 7 3V3 8 IRQ (to main J20), 9 GND 10 5V 12 DIN (to main J17)")
	)
