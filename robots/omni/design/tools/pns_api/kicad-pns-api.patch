+
+HANDLER_RESULT<TuneLengthResult> API_HANDLER_PCB::handleTuneLength( const HANDLER_CONTEXT<TuneLength>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    std::optional<BOARD_ITEM*> item = getItemById( KIID( aCtx.Request.item().value() ) );
+
+    if( !item || ( ( *item )->Type() != PCB_TRACE_T && ( *item )->Type() != PCB_ARC_T ) )
+        return tl::unexpected( toolsError( ApiStatusCode::AS_BAD_REQUEST, "Item not found or not a track" ) );
+
+    PCB_TRACK*      track = static_cast<PCB_TRACK*>( *item );
+    GENERATOR_TOOL* generatorTool = frame()->GetToolManager()->GetTool<GENERATOR_TOOL>();
+
+    if( !generatorTool )
+        return tl::unexpected( toolsError( ApiStatusCode::AS_UNHANDLED, "No generator tool" ) );
+
+    LENGTH_TUNING_MODE mode = aCtx.Request.mode() == TM_DIFF_PAIR        ? LENGTH_TUNING_MODE::DIFF_PAIR
+                              : aCtx.Request.mode() == TM_DIFF_PAIR_SKEW ? LENGTH_TUNING_MODE::DIFF_PAIR_SKEW
+                                                                         : LENGTH_TUNING_MODE::SINGLE;
+
+    frame()->SetActiveLayer( track->GetLayer() );
+
+    PCB_TUNING_PATTERN* pattern = PCB_TUNING_PATTERN::CreateNew( generatorTool, frame(), track, mode );
+
+    if( !pattern )
+        return tl::unexpected( toolsError( ApiStatusCode::AS_BAD_REQUEST, "Cannot tune this track" ) );
+
+    int target = (int) aCtx.Request.target().value_nm();
+    int tol = aCtx.Request.tolerance().value_nm() > 0 ? (int) aCtx.Request.tolerance().value_nm()
+                                                      : pcbIUScale.mmToIU( 0.1 );
+
+    if( target > 0 )
+    {
+        MINOPTMAX<int> range;
+        range.SetMin( target - tol );
+        range.SetOpt( target );
+        range.SetMax( target + tol );
+
+        if( mode == LENGTH_TUNING_MODE::DIFF_PAIR_SKEW )
+            pattern->GetSettings().SetTargetSkew( range );
+        else
+            pattern->GetSettings().SetTargetLength( range );
+
+        pattern->SetOverrideCustomRules( true );
+    }
+
+    if( aCtx.Request.max_amplitude().value_nm() > 0 )
+        pattern->SetMaxAmplitude( (int) aCtx.Request.max_amplitude().value_nm() );
+
+    if( aCtx.Request.spacing().value_nm() > 0 )
+        pattern->SetSpacing( (int) aCtx.Request.spacing().value_nm() );
+
+    // Snap start / end onto the track
+    auto snap =
+            [&]( const VECTOR2I& aP ) -> VECTOR2I
+            {
+                int      dist = 0;
+                VECTOR2I closest = aP;
+                track->GetEffectiveShape()->Collide( aP, std::numeric_limits<int>::max() / 2, &dist, &closest );
+                return closest;
+            };
+
+    pattern->SetPosition( snap( UnpackVector2( aCtx.Request.start() ) ) );
+    pattern->SetEnd( snap( UnpackVector2( aCtx.Request.end() ) ) );
+    pattern->UpdateSideFromEnd();
+
+    BOARD_COMMIT commit( frame() );
+    BOARD*       board = frame()->GetBoard();
+
+    pattern->EditStart( generatorTool, board, &commit );
+    pattern->Update( generatorTool, board, &commit );
+
+    TuneLengthResult response;
+    response.set_length_nm( pattern->GetTuningLengthResult() );
+
+    switch( pattern->GetTuningStatusResult() )
+    {
+    case PNS::MEANDER_PLACER_BASE::TOO_SHORT: response.set_status( "too_short" ); break;
+    case PNS::MEANDER_PLACER_BASE::TOO_LONG:  response.set_status( "too_long" ); break;
+    default:                                  response.set_status( "tuned" ); break;
+    }
+
+    pattern->EditFinish( generatorTool, board, &commit );
+    commit.Push( _( "Tune (API)" ) );
+
+    // A dry run is the real thing undone: cancelling a half-built pattern is not safe
+    if( aCtx.Request.dry_run() )
+        frame()->GetToolManager()->RunAction( ACTIONS::undo );
+    else
+        response.set_committed( true );
+
+    return response;
+}
