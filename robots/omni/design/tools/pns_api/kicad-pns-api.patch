diff --git a/pcbnew/api/api_handler_pcb_router.cpp b/pcbnew/api/api_handler_pcb_router.cpp
new file mode 100644
index 00000000..9f305758
--- /dev/null
+++ b/pcbnew/api/api_handler_pcb_router.cpp
@@ -0,0 +1,322 @@
+/*
+ * This program source code file is part of KiCad, a free EDA CAD application.
+ *
+ * Private extension (BugBot tooling): IPC API handlers for the scripted
+ * push-and-shove router.  Not part of upstream KiCad.
+ *
+ * This program is free software: you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or (at your
+ * option) any later version.
+ */
+
+#include <map>
+
+#include <api/api_handler_pcb.h>
+#include <api/api_enums.h>
+#include <api/api_utils.h>
+#include <board.h>
+#include <netinfo.h>
+#include <pcb_edit_frame.h>
+#include <pcb_track.h>
+#include <tool/tool_manager.h>
+#include <router/router_tool.h>
+#include <router/pns_routing_settings.h>
+
+
+namespace
+{
+
+struct TRACK_STATE
+{
+    KICAD_T      type;
+    VECTOR2I     start;
+    VECTOR2I     end;
+    PCB_LAYER_ID layer;
+    int          width;
+    int          net;
+    PCB_TRACK*   item;
+};
+
+
+std::map<KIID, TRACK_STATE> snapshotTracks( BOARD* aBoard )
+{
+    std::map<KIID, TRACK_STATE> state;
+
+    for( PCB_TRACK* t : aBoard->Tracks() )
+    {
+        state[t->m_Uuid] = { t->Type(), t->GetStart(), t->GetEnd(), t->GetLayer(), t->GetWidth(),
+                             t->GetNetCode(), t };
+    }
+
+    return state;
+}
+
+
+std::string trackTypeName( KICAD_T aType )
+{
+    switch( aType )
+    {
+    case PCB_VIA_T: return "via";
+    case PCB_ARC_T: return "arc";
+    default:        return "track";
+    }
+}
+
+
+void fillChange( RouterItemChange* aChange, const KIID& aId, const TRACK_STATE& aState,
+                 BOARD* aBoard )
+{
+    aChange->mutable_id()->set_value( aId.AsStdString() );
+    aChange->set_type( trackTypeName( aState.type ) );
+
+    if( NETINFO_ITEM* net = aBoard->FindNet( aState.net ) )
+        aChange->set_net( net->GetNetname().ToStdString() );
+}
+
+
+// Compares two snapshots and fills the added / removed / modified lists of the result
+void diffTracks( const std::map<KIID, TRACK_STATE>& aBefore,
+                 const std::map<KIID, TRACK_STATE>& aAfter, BOARD* aBoard, RouterResult& aResult )
+{
+    for( const auto& [id, after] : aAfter )
+    {
+        auto it = aBefore.find( id );
+
+        if( it == aBefore.end() )
+        {
+            fillChange( aResult.add_added(), id, after, aBoard );
+        }
+        else
+        {
+            const TRACK_STATE& b = it->second;
+
+            if( b.start != after.start || b.end != after.end || b.layer != after.layer
+                || b.width != after.width )
+            {
+                fillChange( aResult.add_modified(), id, after, aBoard );
+            }
+        }
+    }
+
+    for( const auto& [id, before] : aBefore )
+    {
+        if( !aAfter.count( id ) )
+            fillChange( aResult.add_removed(), id, before, aBoard );
+    }
+}
+
+
+int toPnsMode( kiapi::board::commands::RouterMode aMode )
+{
+    switch( aMode )
+    {
+    case RTM_SHOVE:      return PNS::RM_Shove;
+    case RTM_WALKAROUND: return PNS::RM_Walkaround;
+    case RTM_HIGHLIGHT:  return PNS::RM_MarkObstacles;
+    default:             return -1;
+    }
+}
+
+
+ApiResponseStatus makeError( ApiStatusCode aCode, const std::string& aMessage )
+{
+    ApiResponseStatus e;
+    e.set_status( aCode );
+    e.set_error_message( aMessage );
+    return e;
+}
+
+} // namespace
+
+
+HANDLER_RESULT<RouterResult> API_HANDLER_PCB::handleRouteTrack(
+        const HANDLER_CONTEXT<RouteTrack>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*        board = frame()->GetBoard();
+    NETINFO_ITEM* net = nullptr;
+
+    if( !aCtx.Request.net().empty() )
+    {
+        net = board->FindNet( wxString::FromUTF8( aCtx.Request.net() ) );
+
+        if( !net )
+            return tl::unexpected( makeError( ApiStatusCode::AS_BAD_REQUEST,
+                                              "Unknown net " + aCtx.Request.net() ) );
+    }
+
+    std::vector<ROUTER_API_WAYPOINT> points;
+
+    for( const RouteWaypoint& wp : aCtx.Request.points() )
+    {
+        ROUTER_API_WAYPOINT p;
+        p.pos = UnpackVector2( wp.position() );
+        p.layer = wp.layer() == kiapi::board::types::BL_UNKNOWN
+                          ? UNDEFINED_LAYER
+                          : FromProtoEnum<PCB_LAYER_ID>( wp.layer() );
+        points.push_back( p );
+    }
+
+    PCB_LAYER_ID layer = aCtx.Request.layer() == kiapi::board::types::BL_UNKNOWN
+                                 ? UNDEFINED_LAYER
+                                 : FromProtoEnum<PCB_LAYER_ID>( aCtx.Request.layer() );
+
+    ROUTER_TOOL* router = frame()->GetToolManager()->GetTool<ROUTER_TOOL>();
+
+    if( !router )
+        return tl::unexpected( makeError( ApiStatusCode::AS_UNHANDLED, "No router tool" ) );
+
+    std::map<KIID, TRACK_STATE> before = snapshotTracks( board );
+    ROUTER_API_RESULT           res;
+
+    router->ApiRouteTrack( net, points, layer, (int) aCtx.Request.width().value_nm(),
+                           (int) aCtx.Request.via_diameter().value_nm(),
+                           (int) aCtx.Request.via_drill().value_nm(),
+                           toPnsMode( aCtx.Request.mode() ), aCtx.Request.allow_partial(),
+                           aCtx.Request.dry_run(), (int) aCtx.Request.step().value_nm(),
+                           aCtx.Request.diff_pair(), (int) aCtx.Request.diff_pair_gap().value_nm(), res );
+
+    RouterResult response;
+    response.set_committed( res.committed );
+    response.set_completed( res.completed );
+    PackVector2( *response.mutable_reached(), res.reached );
+    response.set_message( res.message.ToStdString() );
+
+    if( res.committed )
+        diffTracks( before, snapshotTracks( board ), board, response );
+
+    return response;
+}
+
+
+HANDLER_RESULT<RouterResult> API_HANDLER_PCB::handleDragItem( const HANDLER_CONTEXT<DragItem>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*                     board = frame()->GetBoard();
+    std::optional<BOARD_ITEM*> item = getItemById( KIID( aCtx.Request.item().value() ) );
+
+    if( !item || !( *item )->IsConnected() )
+        return tl::unexpected( makeError( ApiStatusCode::AS_BAD_REQUEST,
+                                          "Item not found or not a track/via" ) );
+
+    ROUTER_TOOL* router = frame()->GetToolManager()->GetTool<ROUTER_TOOL>();
+
+    if( !router )
+        return tl::unexpected( makeError( ApiStatusCode::AS_UNHANDLED, "No router tool" ) );
+
+    VECTOR2I  grab;
+    VECTOR2I* grabPtr = nullptr;
+
+    if( aCtx.Request.has_grab() )
+    {
+        grab = UnpackVector2( aCtx.Request.grab() );
+        grabPtr = &grab;
+    }
+
+    std::map<KIID, TRACK_STATE> before = snapshotTracks( board );
+    ROUTER_API_RESULT           res;
+
+    router->ApiDragItem( static_cast<BOARD_CONNECTED_ITEM*>( *item ), grabPtr,
+                         UnpackVector2( aCtx.Request.target() ), toPnsMode( aCtx.Request.mode() ),
+                         aCtx.Request.free_angle(), aCtx.Request.force(), aCtx.Request.dry_run(),
+                         (int) aCtx.Request.step().value_nm(), res );
+
+    RouterResult response;
+    response.set_committed( res.committed );
+    response.set_completed( res.completed );
+    PackVector2( *response.mutable_reached(), res.reached );
+    response.set_message( res.message.ToStdString() );
+
+    if( res.committed )
+        diffTracks( before, snapshotTracks( board ), board, response );
+
+    return response;
+}
