+
+bool ROUTER_TOOL::ApiRouteTrack( NETINFO_ITEM* aNet, const std::vector<ROUTER_API_WAYPOINT>& aPoints,
+                                 PCB_LAYER_ID aLayer, int aWidth, int aViaDiameter, int aViaDrill,
+                                 int aMode, bool aAllowPartial, bool aDryRun, int aStep,
+                                 bool aDiffPair, int aDiffPairGap, ROUTER_API_RESULT& aResult )
+{
+    if( aPoints.size() < 2 )
+    {
+        aResult.message = wxT( "At least two points (start and end) are needed" );
+        return false;
+    }
+
+    if( !apiBegin( aMode, aResult ) )
+        return false;
+
+    if( aDiffPair && aDryRun )
+    {
+        // The diff pair placer commits every fixed segment to the board, so it cannot be undone here
+        aResult.message = wxT( "dry_run is not supported for differential pairs" );
+        apiEnd();
+        return false;
+    }
+
+    if( aDiffPair )
+        m_router->SetMode( PNS::PNS_MODE_ROUTE_DIFF_PAIR );
+
+    PNS::NET_HANDLE net = aNet;
+    int             pnsLayer = aLayer != UNDEFINED_LAYER ? m_iface->GetPNSLayerFromBoardLayer( aLayer )
+                                                         : -1;
+    VECTOR2I        p0 = aPoints[0].pos;
+    PNS::ITEM*      startItem = apiPickItem( p0, net, pnsLayer );
+
+    if( !startItem && pnsLayer >= 0 )
+        startItem = apiPickItem( p0, net, -1 );
+
+    if( !startItem )
+    {
+        aResult.message = wxString::Format( wxT( "No pad, track or via%s found at the start point" ),
+                                            aNet ? wxT( " of net " ) + aNet->GetNetname()
+                                                 : wxString() );
+        apiEnd();
+        return false;
+    }
+
+    if( !net )
+        net = startItem->Net();
+
+    if( aNet && startItem->Net() != net )
+    {
+        aResult.message = wxT( "The item at the start point is on a different net" );
+        apiEnd();
+        return false;
+    }
+
+    if( pnsLayer < 0 || !startItem->Layers().Overlaps( pnsLayer ) )
+        pnsLayer = startItem->Layers().Start();
+
+    PCB_LAYER_ID pcbLayer = m_iface->GetBoardLayerFromPNSLayer( pnsLayer );
+
+    if( !::IsCopperLayer( pcbLayer ) )
+    {
+        aResult.message = wxT( "Tracks on copper layers only" );
+        apiEnd();
+        return false;
+    }
+
+    frame()->SetActiveLayer( pcbLayer );
+    p0 = apiSnap( startItem, p0 );
+
+    // Sizes: same as prepareInteractive(), then the explicit overrides
+    BOARD_DESIGN_SETTINGS& bds = board()->GetDesignSettings();
+    PNS::SIZES_SETTINGS    sizes( m_router->Sizes() );
+
+    m_iface->SetStartLayerFromPCBNew( pcbLayer );
+    bds.m_TempOverrideTrackWidth = false;
+    m_iface->ImportSizes( sizes, startItem, nullptr, p0 );
+
+    if( aWidth > 0 )
+    {
+        sizes.SetTrackWidth( aWidth );
+        sizes.SetTrackWidthIsExplicit( true );
+
+        if( aDiffPair )
+            sizes.SetDiffPairWidth( aWidth );
+    }
+
+    if( aDiffPair && aDiffPairGap > 0 )
+        sizes.SetDiffPairGap( aDiffPairGap );
+
+    if( aViaDiameter <= 0 )
+        aViaDiameter = sizes.ViaDiameter() > 0 ? sizes.ViaDiameter() : bds.GetCurrentViaSize();
+
+    if( aViaDrill <= 0 )
+        aViaDrill = sizes.ViaDrill() > 0 ? sizes.ViaDrill() : bds.GetCurrentViaDrill();
+
+    sizes.SetViaDiameter( aViaDiameter );
+    sizes.SetViaDrill( aViaDrill );
+    sizes.SetViaType( VIATYPE::THROUGH );
+    sizes.ClearLayerPairs();
+    sizes.AddLayerPair( m_iface->GetPNSLayerFromBoardLayer( F_Cu ),
+                        m_iface->GetPNSLayerFromBoardLayer( B_Cu ) );
+    m_router->UpdateSizes( sizes );
+
+    if( !m_router->StartRouting( p0, startItem, pnsLayer ) )
+    {
+        aResult.message = m_router->FailureReason();
+        apiEnd();
+        return false;
+    }
+
+    // A pair's head ends between the two tracks, so allow up to one pitch of slack
+    int reachTolerance = aDiffPair ? m_router->Sizes().DiffPairGap() + m_router->Sizes().DiffPairWidth() : 0;
+
+    PCB_LAYER_ID curLayer = pcbLayer;
+    bool         completed = true;
+    bool         finished = false;
+    VECTOR2I     reached = p0;
+    VECTOR2I     cursor = p0;
+
+    // Where the routed head really ends.  The pair placer's CurrentEnd() is just the cursor, so for
+    // pairs use the middle of the two lines' last points.
+    auto headEnd =
+            [&]( const VECTOR2I& aFallback ) -> VECTOR2I
+            {
+                if( !aDiffPair )
+                    return m_router->Placer()->CurrentEnd();
+
+                std::vector<VECTOR2I> ends;
+                PNS::ITEM_SET         traces = m_router->Placer()->Traces();
+
+                for( PNS::ITEM* item : traces.CItems() )
+                {
+                    if( item->Kind() == PNS::ITEM::LINE_T )
+                    {
+                        const PNS::LINE* line = static_cast<const PNS::LINE*>( item );
+
+                        if( line->PointCount() > 1 )
+                            ends.push_back( line->CLine().CLastPoint() );
+                    }
+                }
+
+                return ends.size() == 2 ? ( ends[0] + ends[1] ) / 2 : aFallback;
+            };
+
+    for( size_t i = 1; i < aPoints.size() && !finished; i++ )
+    {
+        const ROUTER_API_WAYPOINT& wp = aPoints[i];
+        bool                       last = ( i == aPoints.size() - 1 );
+        bool                       layerChange = wp.layer != UNDEFINED_LAYER && wp.layer != curLayer;
+        VECTOR2I                   p = wp.pos;
+        PNS::ITEM*                 endItem = nullptr;
+
+        if( layerChange )
+        {
+            if( !::IsCopperLayer( wp.layer ) )
+            {
+                aResult.message = wxT( "Waypoint layer is not a copper layer" );
+                completed = false;
+                break;
+            }
+
+            PNS::SIZES_SETTINGS viaSizes( m_router->Sizes() );
+            viaSizes.ClearLayerPairs();
+            viaSizes.AddLayerPair( m_iface->GetPNSLayerFromBoardLayer( curLayer ),
+                                   m_iface->GetPNSLayerFromBoardLayer( wp.layer ) );
+            viaSizes.SetViaDiameter( aViaDiameter );
+            viaSizes.SetViaDrill( aViaDrill );
+            viaSizes.SetViaType( VIATYPE::THROUGH );
+            m_router->UpdateSizes( viaSizes );
+
+            if( !m_router->IsPlacingVia() )
+                m_router->ToggleViaPlacement();
+        }
+        else if( last )
+        {
+            endItem = apiPickItem( p, net, m_iface->GetPNSLayerFromBoardLayer( curLayer ) );
+
+            if( endItem && endItem->Net() == net )
+                p = apiSnap( endItem, p );
+            else
+                endItem = nullptr;
+        }
+
+        apiMoveStepped( cursor, p, endItem, aStep );
+        reached = headEnd( cursor );
+
+        // Like pressing '/' in the GUI: if the head doesn't get there, try the other posture
+        // (straight-first vs. diagonal-first)
+        if( ( reached - p ).EuclideanNorm() > reachTolerance )
+        {
+            m_router->FlipPosture();
+            apiMoveStepped( cursor, p, endItem, aStep );
+            reached = headEnd( cursor );
+
+            if( ( reached - p ).EuclideanNorm() > reachTolerance )
+            {
+                m_router->FlipPosture();
+                m_router->Move( p, endItem );
+                reached = headEnd( cursor );
+            }
+        }
+
+        cursor = p;
+
+        if( ( reached - p ).EuclideanNorm() > reachTolerance )
+        {
+            completed = false;
+            aResult.message = wxString::Format( wxT( "Blocked before waypoint %d" ), (int) i );
+        }
+
+        if( m_router->FixRoute( p, endItem, last, false ) )
+            finished = true;
+
+        if( !completed )
+            break;
+
+        if( layerChange && !finished )
+        {
+            m_router->SwitchLayer( m_iface->GetPNSLayerFromBoardLayer( wp.layer ) );
+            curLayer = wp.layer;
+            frame()->SetActiveLayer( curLayer );
+            updateSizesAfterRouterEvent( m_router->GetCurrentLayer(), p );
+
+            if( aWidth > 0 || ( aDiffPair && aDiffPairGap > 0 ) )
+            {
+                PNS::SIZES_SETTINGS s( m_router->Sizes() );
+
+                if( aWidth > 0 )
+                {
+                    s.SetTrackWidth( aWidth );
+                    s.SetTrackWidthIsExplicit( true );
+
+                    if( aDiffPair )
+                        s.SetDiffPairWidth( aWidth );
+                }
+
+                if( aDiffPair && aDiffPairGap > 0 )
+                    s.SetDiffPairGap( aDiffPairGap );
+
+                m_router->UpdateSizes( s );
+            }
+        }
+    }
+
+    aResult.completed = completed;
+    aResult.reached = reached;
+
+    if( aDryRun || ( !completed && !aAllowPartial ) )
+    {
+        m_router->StopRouting();
+
+        if( !aDryRun && aResult.message.IsEmpty() )
+            aResult.message = wxT( "Route incomplete; discarded" );
+    }
+    else
+    {
+        m_router->CommitRouting();
+        aResult.committed = true;
+    }
+
+    apiEnd();
+    return aResult.committed || aDryRun;
+}
