+HANDLER_RESULT<ProbeResult> API_HANDLER_PCB::handleProbeClearance( const HANDLER_CONTEXT<ProbeClearance>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*        board = frame()->GetBoard();
+    NETINFO_ITEM* net = nullptr;
+
+    if( !aCtx.Request.net().empty() )
+    {
+        net = board->FindNet( wxString::FromUTF8( aCtx.Request.net() ) );
+
+        if( !net )
+            return tl::unexpected( toolsError( ApiStatusCode::AS_BAD_REQUEST, "Unknown net " + aCtx.Request.net() ) );
+    }
+
+    int kind = aCtx.Request.kind() == PK_SEGMENT ? 2 : aCtx.Request.kind() == PK_VIA ? 3 : 1;
+
+    PCB_LAYER_ID layer = aCtx.Request.layer() == kiapi::board::types::BL_UNKNOWN
+                                 ? F_Cu
+                                 : FromProtoEnum<PCB_LAYER_ID>( aCtx.Request.layer() );
+
+    ROUTER_TOOL* router = frame()->GetToolManager()->GetTool<ROUTER_TOOL>();
+
+    if( !router )
+        return tl::unexpected( toolsError( ApiStatusCode::AS_UNHANDLED, "No router tool" ) );
+
+    ROUTER_API_PROBE res;
+
+    if( !router->ApiProbeClearance( kind, UnpackVector2( aCtx.Request.start() ), UnpackVector2( aCtx.Request.end() ),
+                                    layer, net, (int) aCtx.Request.width().value_nm(),
+                                    (int) aCtx.Request.via_diameter().value_nm(),
+                                    (int) aCtx.Request.via_drill().value_nm(),
+                                    (int) aCtx.Request.search_radius().value_nm(), aCtx.Request.max_results(), res ) )
+    {
+        return tl::unexpected( toolsError( ApiStatusCode::AS_BUSY, res.message.ToStdString() ) );
+    }
+
+    ProbeResult response;
+    response.set_ok( res.ok );
+    response.set_min_margin_nm( res.minMargin );
+    response.set_message( res.message.ToStdString() );
+
+    for( const ROUTER_API_OBSTACLE& o : res.obstacles )
+    {
+        ProbeObstacle* out = response.add_obstacles();
+        out->set_kind( o.kind.ToStdString() );
+        out->set_net( o.net.ToStdString() );
+        out->mutable_item()->set_value( o.id.AsStdString() );
+        out->set_description( o.description.ToStdString() );
+        out->set_distance_nm( o.distance );
+        out->set_required_nm( o.required );
+        out->set_margin_nm( o.distance - o.required );
+
+        if( o.layer != UNDEFINED_LAYER )
+            out->set_layer( ToProtoEnum<PCB_LAYER_ID, kiapi::board::types::BoardLayer>( o.layer ) );
+    }
+
+    return response;
+}
