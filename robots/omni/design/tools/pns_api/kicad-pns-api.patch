+VECTOR2I ROUTER_TOOL::apiSnap( PNS::ITEM* aItem, const VECTOR2I& aP )
+{
+    // Like snapToItem(), but never snaps to the grid: scripted coordinates are exact.
+    if( !aItem )
+        return aP;
+
+    switch( aItem->Kind() )
+    {
+    case PNS::ITEM::SOLID_T:
+    {
+        PNS::SOLID* solid = static_cast<PNS::SOLID*>( aItem );
+
+        if( solid->AnchorPoints().empty() )
+            return solid->Anchor( 0 );
+
+        VECTOR2I    best = solid->Anchor( 0 );
+        SEG::ecoord bestDist = std::numeric_limits<SEG::ecoord>::max();
+
+        for( const VECTOR2I& anchor : solid->AnchorPoints() )
+        {
+            SEG::ecoord d = ( aP - anchor ).SquaredEuclideanNorm();
+
+            if( d < bestDist )
+            {
+                bestDist = d;
+                best = anchor;
+            }
+        }
+
+        return best;
+    }
+
+    case PNS::ITEM::VIA_T:
+        return static_cast<PNS::VIA*>( aItem )->Pos();
+
+    case PNS::ITEM::SEGMENT_T:
+    {
+        PNS::SEGMENT* seg = static_cast<PNS::SEGMENT*>( aItem );
+        VECTOR2I      A = seg->Anchor( 0 );
+        VECTOR2I      B = seg->Anchor( 1 );
+        SEG::ecoord   w_sq = SEG::Square( seg->Width() / 2 );
+        SEG::ecoord   dA = ( aP - A ).SquaredEuclideanNorm();
+        SEG::ecoord   dB = ( aP - B ).SquaredEuclideanNorm();
+
+        if( dA < w_sq || dB < w_sq )
+            return dA < dB ? A : B;
+
+        return seg->Seg().NearestPoint( aP );
+    }
+
+    case PNS::ITEM::ARC_T:
+    {
+        PNS::LINKED_ITEM* li = static_cast<PNS::LINKED_ITEM*>( aItem );
+        VECTOR2I          A = li->Anchor( 0 );
+        VECTOR2I          B = li->Anchor( 1 );
+
+        return ( aP - A ).SquaredEuclideanNorm() < ( aP - B ).SquaredEuclideanNorm() ? A : B;
+    }
+
+    default:
+        return aP;
+    }
+}
+
+
+void ROUTER_TOOL::apiMoveStepped( const VECTOR2I& aFrom, const VECTOR2I& aTo, PNS::ITEM* aEndItem,
+                                  int aStep )
+{
+    // Feed the router intermediate cursor positions like mouse motion does, so that shoved items
+    // are pushed gradually (a single long jump can land on the far side of an obstacle).
+    if( aStep <= 0 )
+        aStep = pcbIUScale.mmToIU( 0.1 );
+
+    VECTOR2D d = VECTOR2D( aTo - aFrom );
+    int      n = (int) std::min<double>( 2000.0, std::floor( d.EuclideanNorm() / aStep ) );
+
+    for( int k = 1; k < n; k++ )
+        m_router->Move( aFrom + VECTOR2I( KiROUND( d.x * k / n ), KiROUND( d.y * k / n ) ), nullptr );
+
+    m_router->Move( aTo, aEndItem );
+}
