+HANDLER_RESULT<UnroutedResponse> API_HANDLER_PCB::handleGetUnrouted( const HANDLER_CONTEXT<GetUnrouted>& aCtx )
+{
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*                     board = frame()->GetBoard();
+    std::vector<NETINFO_ITEM*> nets;
+
+    if( std::optional<ApiResponseStatus> err = resolveNets( board, aCtx.Request.nets(), nets ) )
+        return tl::unexpected( *err );
+
+    if( nets.empty() )
+    {
+        for( NETINFO_ITEM* net : board->GetNetInfo() )
+        {
+            if( net->GetNetCode() > 0 )
+                nets.push_back( net );
+        }
+    }
+
+    std::shared_ptr<CONNECTIVITY_DATA> conn = board->GetConnectivity();
+    UnroutedResponse                   response;
+
+    for( NETINFO_ITEM* net : nets )
+    {
+        RN_NET* rn = conn->GetRatsnestForNet( net->GetNetCode() );
+
+        if( !rn )
+            continue;
+
+        for( const CN_EDGE& edge : rn->GetEdges() )
+        {
+            std::shared_ptr<const CN_ANCHOR> a = edge.GetSourceNode();
+            std::shared_ptr<const CN_ANCHOR> b = edge.GetTargetNode();
+
+            if( !a || !b || a->Dirty() || b->Dirty() )
+                continue;
+
+            UnroutedLink* link = response.add_links();
+            link->set_net( net->GetNetname().ToStdString() );
+            fillEndpoint( link->mutable_a(), *a, board );
+            fillEndpoint( link->mutable_b(), *b, board );
+            link->set_length_nm( (int64_t) ( a->Pos() - b->Pos() ).EuclideanNorm() );
+        }
+    }
+
+    response.set_unconnected_count( (int) conn->GetUnconnectedCount( false ) );
+    return response;
+}
