+ApiResponseStatus toolsError( ApiStatusCode aCode, const std::string& aMessage )
+{
+    ApiResponseStatus e;
+    e.set_status( aCode );
+    e.set_error_message( aMessage );
+    return e;
+}
+
+
+std::string itemType( const BOARD_ITEM* aItem )
+{
+    switch( aItem->Type() )
+    {
+    case PCB_PAD_T:   return "pad";
+    case PCB_VIA_T:   return "via";
+    case PCB_TRACE_T: return "track";
+    case PCB_ARC_T:   return "arc";
+    case PCB_ZONE_T:  return "zone";
+    default:          return "item";
+    }
+}
+
+
+std::string itemDescription( const BOARD_ITEM* aItem )
+{
+    if( aItem->Type() == PCB_PAD_T )
+    {
+        const PAD* pad = static_cast<const PAD*>( aItem );
+
+        if( const FOOTPRINT* fp = pad->GetParentFootprint() )
+            return ( fp->GetReference() + wxT( "." ) + pad->GetNumber() ).ToStdString();
+
+        return ( wxT( "pad " ) + pad->GetNumber() ).ToStdString();
+    }
+
+    if( aItem->Type() == PCB_ZONE_T )
+    {
+        const ZONE* zone = static_cast<const ZONE*>( aItem );
+        return ( wxT( "zone " ) + zone->GetZoneName() ).ToStdString();
+    }
+
+    return itemType( aItem );
+}
+
+
+LSEQ copperLayers( const BOARD* aBoard, const BOARD_ITEM* aItem )
+{
+    return LSET( aItem->GetLayerSet() & LSET::AllCuMask( aBoard->GetCopperLayerCount() ) ).CuStack();
+}
+
+
+void fillEndpoint( UnroutedEndpoint* aOut, const CN_ANCHOR& aAnchor, const BOARD* aBoard )
+{
+    PackVector2( *aOut->mutable_position(), aAnchor.Pos() );
+
+    BOARD_CONNECTED_ITEM* item = aAnchor.Parent();
+
+    if( !item )
+        return;
+
+    aOut->mutable_item()->set_value( item->m_Uuid.AsStdString() );
+    aOut->set_type( itemType( item ) );
+    aOut->set_description( itemDescription( item ) );
+
+    LSEQ layers = copperLayers( aBoard, item );
+
+    // For a zone the anchor belongs to one layer of it
+    if( item->Type() == PCB_ZONE_T && aAnchor.Item() )
+        layers = { aAnchor.Item()->GetBoardLayer() };
+
+    for( PCB_LAYER_ID layer : layers )
+        aOut->add_layers( ToProtoEnum<PCB_LAYER_ID, kiapi::board::types::BoardLayer>( layer ) );
+
+    if( !layers.empty() )
+        aOut->set_layer( ToProtoEnum<PCB_LAYER_ID, kiapi::board::types::BoardLayer>( layers.front() ) );
+}
+
+
+std::optional<ApiResponseStatus> resolveNets( BOARD* aBoard, const google::protobuf::RepeatedPtrField<std::string>& aNames,
+                                              std::vector<NETINFO_ITEM*>& aNets )
+{
+    for( const std::string& name : aNames )
+    {
+        NETINFO_ITEM* net = aBoard->FindNet( wxString::FromUTF8( name ) );
+
+        if( !net )
+            return toolsError( ApiStatusCode::AS_BAD_REQUEST, "Unknown net " + name );
+
+        aNets.push_back( net );
+    }
+
+    return std::nullopt;
+}
