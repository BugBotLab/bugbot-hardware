+HANDLER_RESULT<ZoneIslandsResponse> API_HANDLER_PCB::handleGetZoneIslands(
+        const HANDLER_CONTEXT<GetZoneIslands>& aCtx )
+{
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*                     board = frame()->GetBoard();
+    std::vector<NETINFO_ITEM*> nets;
+
+    if( std::optional<ApiResponseStatus> err = resolveNets( board, aCtx.Request.nets(), nets ) )
+        return tl::unexpected( *err );
+
+    std::set<NETINFO_ITEM*> netFilter( nets.begin(), nets.end() );
+
+    std::shared_ptr<CN_CONNECTIVITY_ALGO> algo = board->GetConnectivity()->GetConnectivityAlgo();
+    const CN_CONNECTIVITY_ALGO::CLUSTERS  clusters =
+            algo->SearchClusters( CN_CONNECTIVITY_ALGO::CSM_CONNECTIVITY_CHECK );
+
+    std::map<const CN_ITEM*, std::shared_ptr<CN_CLUSTER>> clusterOf;
+
+    for( const std::shared_ptr<CN_CLUSTER>& cluster : clusters )
+    {
+        for( CN_ITEM* item : *cluster )
+            clusterOf[item] = cluster;
+    }
+
+    // Zone layer items by (zone, layer, outline)
+    std::map<std::tuple<const ZONE*, PCB_LAYER_ID, int>, CN_ZONE_LAYER*> zoneItems;
+
+    for( CN_ITEM* item : algo->ItemList() )
+    {
+        if( item->Valid() && item->Parent() && item->Parent()->Type() == PCB_ZONE_T )
+        {
+            CN_ZONE_LAYER* z = static_cast<CN_ZONE_LAYER*>( item );
+            zoneItems[{ static_cast<const ZONE*>( item->Parent() ), z->GetBoardLayer(), z->SubpolyIndex() }] = z;
+        }
+    }
+
+    ZoneIslandsResponse response;
+
+    for( ZONE* zone : board->Zones() )
+    {
+        if( zone->GetIsRuleArea() || zone->IsTeardropArea() || !zone->IsOnCopperLayer() )
+            continue;
+
+        if( !netFilter.empty() && !netFilter.count( zone->GetNet() ) )
+            continue;
+
+        for( PCB_LAYER_ID layer : LSET( zone->GetLayerSet() & LSET::AllCuMask( board->GetCopperLayerCount() ) ).CuStack() )
+        {
+            std::shared_ptr<SHAPE_POLY_SET> fill = zone->GetFilledPolysList( layer );
+
+            if( !fill )
+                continue;
+
+            for( int idx = 0; idx < fill->OutlineCount(); idx++ )
+            {
+                ZoneIsland* island = response.add_islands();
+                island->mutable_zone()->set_value( zone->m_Uuid.AsStdString() );
+                island->set_zone_name( zone->GetZoneName().ToStdString() );
+                island->set_net( zone->GetNetname().ToStdString() );
+                island->set_layer( ToProtoEnum<PCB_LAYER_ID, kiapi::board::types::BoardLayer>( layer ) );
+                island->set_index( idx );
+
+                double area = fill->Outline( idx ).Area();
+
+                for( int h = 0; h < fill->HoleCount( idx ); h++ )
+                    area -= fill->Hole( idx, h ).Area();
+
+                island->set_area_mm2( area / ( pcbIUScale.IU_PER_MM * pcbIUScale.IU_PER_MM ) );
+                PackBox2( *island->mutable_bbox(), fill->Outline( idx ).BBox() );
+                PackVector2( *island->mutable_anchor(), fill->Outline( idx ).CPoint( 0 ) );
+
+                auto it = zoneItems.find( { zone, layer, idx } );
+
+                if( it == zoneItems.end() )
+                {
+                    island->set_isolated( true );
+                    continue;
+                }
+
+                CN_ZONE_LAYER*     z = it->second;
+                std::set<const BOARD_ITEM*> directSeen;
+
+                island->set_single_connection( z->HasSingleConnection() );
+
+                for( CN_ITEM* c : z->ConnectedItems() )
+                {
+                    const BOARD_CONNECTED_ITEM* parent = c->Parent();
+
+                    if( !parent || parent == zone || directSeen.count( parent ) )
+                        continue;
+
+                    directSeen.insert( parent );
+
+                    ZoneIslandItem* d = island->add_direct();
+                    d->mutable_item()->set_value( parent->m_Uuid.AsStdString() );
+                    d->set_type( itemType( parent ) );
+                    d->set_description( itemDescription( parent ) );
+                }
+
+                auto cl = clusterOf.find( z );
+
+                if( cl == clusterOf.end() )
+                {
+                    island->set_isolated( true );
+                    continue;
+                }
+
+                island->set_isolated( cl->second->IsOrphaned() );
+
+                std::set<const BOARD_ITEM*> pads;
+
+                for( CN_ITEM* ci : *cl->second )
+                {
+                    if( ci->Parent() && ci->Parent()->Type() == PCB_PAD_T && !pads.count( ci->Parent() ) )
+                    {
+                        pads.insert( ci->Parent() );
+
+                        if( island->pads_size() < 30 )
+                            island->add_pads( itemDescription( ci->Parent() ) );
+                    }
+                }
+
+                island->set_cluster_pads( (int) pads.size() );
+            }
+        }
+    }
+
+    return response;
+}
