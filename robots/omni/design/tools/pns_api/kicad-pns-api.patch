+bool ROUTER_TOOL::ApiProbeClearance( int aKind, const VECTOR2I& aStart, const VECTOR2I& aEnd,
+                                     PCB_LAYER_ID aLayer, NETINFO_ITEM* aNet, int aWidth, int aViaDiameter,
+                                     int aViaDrill, int aRadius, int aMaxResults, ROUTER_API_PROBE& aResult )
+{
+    ROUTER_API_RESULT begin;
+
+    if( !apiBegin( -1, begin ) )
+    {
+        aResult.message = begin.message;
+        return false;
+    }
+
+    PNS::NODE*          world = m_router->GetWorld();
+    PNS::RULE_RESOLVER* rules = m_router->GetRuleResolver();
+    int                 top = m_iface->GetPNSLayerFromBoardLayer( F_Cu );
+    int                 bottom = m_iface->GetPNSLayerFromBoardLayer( B_Cu );
+    int                 pnsLayer = ( aKind == 3 || aLayer == UNDEFINED_LAYER )
+                                           ? top : m_iface->GetPNSLayerFromBoardLayer( aLayer );
+
+    if( aRadius <= 0 )
+        aRadius = pcbIUScale.mmToIU( 1.0 );
+
+    if( aMaxResults <= 0 )
+        aMaxResults = 10;
+
+    // Default sizes from the rules for this net
+    PNS::SEGMENT    dummy( SEG( aStart, aStart ), aNet );
+    PNS::CONSTRAINT constraint;
+    dummy.SetLayer( pnsLayer );
+
+    if( aWidth <= 0 )
+    {
+        aWidth = board()->GetDesignSettings().m_TrackMinWidth;
+
+        if( rules->QueryConstraint( PNS::CONSTRAINT_TYPE::CT_WIDTH, &dummy, nullptr, pnsLayer, &constraint ) )
+            aWidth = std::max( aWidth, constraint.m_Value.Opt() );
+    }
+
+    if( aViaDiameter <= 0 )
+    {
+        aViaDiameter = board()->GetDesignSettings().GetCurrentViaSize();
+
+        if( rules->QueryConstraint( PNS::CONSTRAINT_TYPE::CT_VIA_DIAMETER, &dummy, nullptr, pnsLayer,
+                                    &constraint ) && constraint.m_Value.Opt() > 0 )
+        {
+            aViaDiameter = constraint.m_Value.Opt();
+        }
+    }
+
+    if( aViaDrill <= 0 )
+    {
+        aViaDrill = board()->GetDesignSettings().GetCurrentViaDrill();
+
+        if( rules->QueryConstraint( PNS::CONSTRAINT_TYPE::CT_VIA_HOLE, &dummy, nullptr, pnsLayer,
+                                    &constraint ) && constraint.m_Value.Opt() > 0 )
+        {
+            aViaDrill = constraint.m_Value.Opt();
+        }
+    }
+
+    std::unique_ptr<PNS::ITEM> probe;
+
+    if( aKind == 3 )
+    {
+        probe = std::make_unique<PNS::VIA>( aStart, PNS_LAYER_RANGE( top, bottom ), aViaDiameter, aViaDrill,
+                                            aNet );
+    }
+    else
+    {
+        auto seg = std::make_unique<PNS::SEGMENT>( SEG( aStart, aKind == 2 ? aEnd : aStart ), aNet );
+        seg->SetWidth( aWidth );
+        seg->SetLayer( pnsLayer );
+        probe = std::move( seg );
+    }
+
+    aResult.ok = !world->CheckColliding( probe.get() );
+
+    PNS::NODE::OBSTACLES          found;
+    PNS::COLLISION_SEARCH_OPTIONS opts;
+    opts.m_overrideClearance = aRadius;
+    opts.m_useClearanceEpsilon = false;
+    world->QueryColliding( probe.get(), found, opts );
+
+    std::set<const PNS::ITEM*> seen;
+    aResult.minMargin = aRadius;
+
+    for( const PNS::OBSTACLE& obs : found )
+    {
+        const PNS::ITEM* item = obs.m_item;
+
+        if( !item || seen.count( item ) )
+            continue;
+
+        seen.insert( item );
+
+        // Measure on the first copper layer both items share
+        int layer = std::max( probe->Layers().Start(), item->Layers().Start() );
+
+        if( layer > std::min( probe->Layers().End(), item->Layers().End() ) )
+            layer = item->Layers().Start();
+
+        const SHAPE* ps = probe->Shape( layer );
+        const SHAPE* os = item->Shape( layer );
+
+        if( !ps || !os )
+            continue;
+
+        int actual = aRadius;
+
+        if( !ps->Collide( os, aRadius, &actual ) )
+            continue;
+
+        ROUTER_API_OBSTACLE o;
+        BOARD_ITEM*         parent = item->Parent() ? item->Parent() : item->BoardItem();
+
+        if( item->Kind() == PNS::ITEM::HOLE_T )
+        {
+            const PNS::HOLE* hole = static_cast<const PNS::HOLE*>( item );
+
+            if( hole->ParentPadVia() && hole->ParentPadVia()->Parent() )
+                parent = hole->ParentPadVia()->Parent();
+        }
+
+        o.kind = apiItemKind( item );
+        o.description = apiItemDescription( parent );
+        o.distance = actual;
+        o.required = rules->Clearance( probe.get(), item, false );
+        o.layer = m_iface->GetBoardLayerFromPNSLayer( layer );
+
+        if( parent )
+            o.id = parent->m_Uuid;
+
+        if( NETINFO_ITEM* n = static_cast<NETINFO_ITEM*>( item->Net() ) )
+            o.net = n->GetNetname();
+
+        aResult.minMargin = std::min( aResult.minMargin, o.distance - o.required );
+        aResult.obstacles.push_back( o );
+    }
+
+    std::sort( aResult.obstacles.begin(), aResult.obstacles.end(),
+               []( const ROUTER_API_OBSTACLE& a, const ROUTER_API_OBSTACLE& b )
+               {
+                   return a.distance - a.required < b.distance - b.required;
+               } );
+
+    if( (int) aResult.obstacles.size() > aMaxResults )
+        aResult.obstacles.resize( aMaxResults );
+
+    apiEnd();
+    return true;
+}
