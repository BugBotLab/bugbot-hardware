+HANDLER_RESULT<UpdateFromNetlistResponse> API_HANDLER_PCB::handleUpdateFromNetlist(
+        const HANDLER_CONTEXT<UpdateFromNetlist>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    NETLIST netlist;
+
+    try
+    {
+        FILE_LINE_READER*    reader = new FILE_LINE_READER( wxString::FromUTF8( aCtx.Request.netlist_path() ) );
+        KICAD_NETLIST_READER netlistReader( reader, &netlist );
+        netlistReader.LoadNetlist();
+    }
+    catch( const IO_ERROR& e )
+    {
+        return tl::unexpected( toolsError( ApiStatusCode::AS_BAD_REQUEST,
+                                           "Cannot read netlist: " + e.What().ToStdString() ) );
+    }
+
+    bool dryRun = aCtx.Request.dry_run();
+
+    netlist.SetFindByTimeStamp( !aCtx.Request.relink_by_reference() );
+    netlist.SetReplaceFootprints( aCtx.Request.replace_footprints() );
+
+    if( !dryRun )
+    {
+        frame()->GetToolManager()->DeactivateTool();
+        frame()->GetToolManager()->RunAction( ACTIONS::selectionClear );
+    }
+
+    WX_STRING_REPORTER    reporter;
+    BOARD_NETLIST_UPDATER updater( frame(), frame()->GetBoard() );
+
+    updater.SetReporter( &reporter );
+    updater.SetIsDryRun( dryRun );
+    updater.SetLookupByTimestamp( !aCtx.Request.relink_by_reference() );
+    updater.SetDeleteUnusedFootprints( aCtx.Request.delete_unused_footprints() );
+    updater.SetReplaceFootprints( aCtx.Request.replace_footprints() );
+    updater.SetOverrideLocks( aCtx.Request.override_locks() );
+    updater.SetUpdateFields( aCtx.Request.update_fields() );
+    bool ok = updater.UpdateNetlist( netlist );
+
+    if( !dryRun )
+    {
+        bool runDragCommand = false;
+        frame()->OnNetlistChanged( updater, &runDragCommand );
+    }
+
+    UpdateFromNetlistResponse response;
+    response.set_applied( ok && !dryRun );
+    response.set_report( reporter.GetMessages().ToStdString() );
+    return response;
+}
