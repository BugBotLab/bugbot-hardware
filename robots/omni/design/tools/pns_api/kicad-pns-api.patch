+HANDLER_RESULT<TeardropsResponse> API_HANDLER_PCB::handleSetTeardrops( const HANDLER_CONTEXT<SetTeardrops>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*                     board = frame()->GetBoard();
+    std::vector<NETINFO_ITEM*> nets;
+
+    if( std::optional<ApiResponseStatus> err = resolveNets( board, aCtx.Request.nets(), nets ) )
+        return tl::unexpected( *err );
+
+    std::set<NETINFO_ITEM*> netFilter( nets.begin(), nets.end() );
+    bool                    enable = aCtx.Request.enable();
+    int                     changed = 0;
+    BOARD_COMMIT            commit( frame() );
+
+    auto visit =
+            [&]( BOARD_CONNECTED_ITEM* aItem, TEARDROP_PARAMETERS& aParams )
+            {
+                if( !netFilter.empty() && !netFilter.count( aItem->GetNet() ) )
+                    return;
+
+                if( aParams.m_Enabled == enable )
+                    return;
+
+                commit.Modify( aItem );
+                aParams.m_Enabled = enable;
+                changed++;
+            };
+
+    if( aCtx.Request.vias() )
+    {
+        for( PCB_TRACK* track : board->Tracks() )
+        {
+            if( track->Type() == PCB_VIA_T )
+                visit( track, static_cast<PCB_VIA*>( track )->GetTeardropParams() );
+        }
+    }
+
+    for( FOOTPRINT* fp : board->Footprints() )
+    {
+        for( PAD* pad : fp->Pads() )
+        {
+            bool pth = pad->GetAttribute() == PAD_ATTRIB::PTH;
+            bool smd = pad->GetAttribute() == PAD_ATTRIB::SMD || pad->GetAttribute() == PAD_ATTRIB::CONN;
+
+            if( ( pth && aCtx.Request.pth_pads() ) || ( smd && aCtx.Request.smd_pads() ) )
+                visit( pad, pad->GetTeardropParams() );
+        }
+    }
+
+    if( aCtx.Request.track_to_track() )
+    {
+        TEARDROP_PARAMETERS* target = board->GetDesignSettings().GetTeadropParamsList()->GetParameters( TARGET_TRACK );
+        TEARDROP_MANAGER     mgr( board, frame()->GetToolManager() );
+
+        mgr.DeleteTrackToTrackTeardrops( commit );
+        mgr.BuildTrackCaches();
+        target->m_Enabled = enable;
+
+        if( enable )
+            mgr.AddTeardropsOnTracks( commit, nullptr, true );
+    }
+
+    commit.Push( _( "Edit Teardrops (API)" ), SKIP_TEARDROPS );
+
+    TEARDROP_MANAGER teardropMgr( board, frame()->GetToolManager() );
+    BOARD_COMMIT     commit2( frame() );
+    teardropMgr.UpdateTeardrops( commit2, nullptr, nullptr, true );
+    commit2.Push( _( "Edit Teardrops (API)" ), SKIP_TEARDROPS | APPEND_UNDO );
+
+    int teardrops = 0;
+
+    for( ZONE* zone : board->Zones() )
+    {
+        if( zone->IsTeardropArea() )
+            teardrops++;
+    }
+
+    TeardropsResponse response;
+    response.set_items_changed( changed );
+    response.set_teardrop_zones( teardrops );
+    return response;
+}
