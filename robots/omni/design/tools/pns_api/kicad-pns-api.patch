+HANDLER_RESULT<RouterResult> API_HANDLER_PCB::handleOptimizeNets(
+        const HANDLER_CONTEXT<OptimizeNets>& aCtx )
+{
+    if( std::optional<ApiResponseStatus> busy = checkForBusy() )
+        return tl::unexpected( *busy );
+
+    HANDLER_RESULT<bool> documentValidation = validateDocument( aCtx.Request.board() );
+
+    if( !documentValidation )
+        return tl::unexpected( documentValidation.error() );
+
+    BOARD*                     board = frame()->GetBoard();
+    std::vector<NETINFO_ITEM*> nets;
+
+    for( const std::string& name : aCtx.Request.nets() )
+    {
+        NETINFO_ITEM* net = board->FindNet( wxString::FromUTF8( name ) );
+
+        if( !net )
+            return tl::unexpected( makeError( ApiStatusCode::AS_BAD_REQUEST,
+                                              "Unknown net " + name ) );
+
+        nets.push_back( net );
+    }
+
+    std::optional<BOX2I> area;
+
+    if( aCtx.Request.has_area() )
+    {
+        area = UnpackBox2( aCtx.Request.area() );
+        area->Normalize();
+
+        // An area without nets: every net with a track in it
+        if( nets.empty() )
+        {
+            std::set<NETINFO_ITEM*> inArea;
+
+            for( PCB_TRACK* track : board->Tracks() )
+            {
+                if( track->GetNetCode() > 0
+                    && ( area->Contains( track->GetStart() ) || area->Contains( track->GetEnd() ) ) )
+                {
+                    inArea.insert( track->GetNet() );
+                }
+            }
+
+            nets.assign( inArea.begin(), inArea.end() );
+        }
+    }
+
+    ROUTER_TOOL* router = frame()->GetToolManager()->GetTool<ROUTER_TOOL>();
+
+    if( !router )
+        return tl::unexpected( makeError( ApiStatusCode::AS_UNHANDLED, "No router tool" ) );
+
+    std::map<KIID, TRACK_STATE> before = snapshotTracks( board );
+    ROUTER_API_RESULT           res;
+
+    router->ApiOptimizeNets( nets, aCtx.Request.effort(), aCtx.Request.keep_topology(),
+                             aCtx.Request.dry_run(), area, res );
+
+    RouterResult response;
+    response.set_committed( res.committed );
+    response.set_completed( res.completed );
+    response.set_message( res.message.ToStdString() );
+
+    if( res.committed )
+        diffTracks( before, snapshotTracks( board ), board, response );
+
+    return response;
+}
