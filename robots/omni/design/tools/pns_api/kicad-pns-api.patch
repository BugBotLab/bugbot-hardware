+bool ROUTER_TOOL::apiBegin( int aMode, ROUTER_API_RESULT& aResult )
+{
+    if( m_inRouterTool || m_router->RoutingInProgress() )
+    {
+        aResult.message = wxT( "The interactive router is in use" );
+        return false;
+    }
+
+    m_iface->SetBoard( board() );
+    m_router->ClearViewDecorations();
+    m_router->SyncWorld();
+    m_router->SetMode( PNS::PNS_MODE_ROUTE_SINGLE );
+
+    PNS::ROUTING_SETTINGS& settings = m_router->Settings();
+    m_apiSavedMode = settings.Mode();
+    m_apiSavedFixAll = settings.GetFixAllSegments();
+    m_apiSavedLayer = frame()->GetActiveLayer();
+
+    if( aMode >= 0 )
+        settings.SetMode( static_cast<PNS::PNS_MODE>( aMode ) );
+
+    // Every waypoint is a real vertex, not just a hint for the posture of the last segment
+    settings.SetFixAllSegments( true );
+
+    m_inRouterTool = true;
+    return true;
+}
+
+
+void ROUTER_TOOL::apiEnd()
+{
+    if( m_router->RoutingInProgress() )
+        m_router->StopRouting();
+
+    m_router->GetWorld()->KillChildren();
+    m_router->ClearViewDecorations();
+
+    PNS::ROUTING_SETTINGS& settings = m_router->Settings();
+    settings.SetMode( m_apiSavedMode );
+    settings.SetFixAllSegments( m_apiSavedFixAll );
+
+    if( m_apiSavedLayer != UNDEFINED_LAYER )
+        frame()->SetActiveLayer( m_apiSavedLayer );
+
+    m_iface->SetCommitFlags( 0 );
+    m_inRouterTool = false;
+    frame()->GetCanvas()->Refresh();
+}
