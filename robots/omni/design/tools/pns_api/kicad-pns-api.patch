+PNS::ITEM* ROUTER_TOOL::apiPickItem( const VECTOR2I& aWhere, PNS::NET_HANDLE aNet, int aPnsLayer,
+                                     bool aIgnorePads )
+{
+    // pickSingleItem() treats layer 0 (F.Cu) as "use the view's top layer", so make the
+    // active layer match the requested one first.
+    if( aPnsLayer >= 0 )
+        frame()->SetActiveLayer( m_iface->GetBoardLayerFromPNSLayer( aPnsLayer ) );
+
+    return pickSingleItem( aWhere, aNet, aPnsLayer, aIgnorePads );
+}
