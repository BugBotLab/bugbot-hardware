+
+bool ROUTER_TOOL::ApiDragItem( BOARD_CONNECTED_ITEM* aItem, const VECTOR2I* aGrab,
+                               const VECTOR2I& aTarget, int aMode, bool aFreeAngle, bool aForce,
+                               bool aDryRun, int aStep, ROUTER_API_RESULT& aResult )
+{
+    if( !apiBegin( aMode, aResult ) )
+        return false;
+
+    PNS::ITEM* item = m_router->GetWorld()->FindItemByParent( aItem );
+
+    if( !item || !item->OfKind( PNS::ITEM::SEGMENT_T | PNS::ITEM::VIA_T ) )
+    {
+        aResult.message = item ? wxT( "Only track segments and vias can be dragged (not arcs)" )
+                               : wxT( "Item not found in the router world" );
+        apiEnd();
+        return false;
+    }
+
+    VECTOR2I grab;
+
+    if( aGrab )
+        grab = *aGrab;
+    else if( item->OfKind( PNS::ITEM::VIA_T ) )
+        grab = static_cast<PNS::VIA*>( item )->Pos();
+    else
+        grab = static_cast<PNS::SEGMENT*>( item )->Seg().Center();
+
+    grab = apiSnap( item, grab );
+    frame()->SetActiveLayer( m_iface->GetBoardLayerFromPNSLayer( item->Layers().Start() ) );
+
+    int dragMode = PNS::DM_ANY;
+
+    if( aFreeAngle )
+        dragMode |= PNS::DM_FREE_ANGLE;
+
+    if( !m_router->StartDragging( grab, item, dragMode ) )
+    {
+        aResult.message = m_router->FailureReason();
+
+        if( aResult.message.IsEmpty() )
+            aResult.message = wxT( "Could not start dragging" );
+
+        apiEnd();
+        return false;
+    }
+
+    apiMoveStepped( grab, aTarget, nullptr, aStep );
+
+    bool dragStatus = false;
+
+    if( PNS::DRAG_ALGO* dragger = m_router->GetDragger() )
+        dragger->GetForceMarkObstaclesMode( &dragStatus );
+
+    aResult.completed = dragStatus;
+    aResult.reached = aTarget;
+
+    if( !dragStatus )
+        aResult.message = wxT( "Target position is not valid; using the last valid position" );
+
+    if( !aDryRun && m_router->FixRoute( aTarget, nullptr, false, aForce ) )
+        aResult.committed = true;
+    else if( !aDryRun )
+        aResult.message = wxT( "Drag could not be committed (DRC violation)" );
+
+    apiEnd();
+    return aResult.committed || aDryRun;
+}
+
+
+bool ROUTER_TOOL::ApiOptimizeNets( const std::vector<NETINFO_ITEM*>& aNets, int aEffort,
+                                   bool aKeepTopology, bool aDryRun, const std::optional<BOX2I>& aArea,
+                                   ROUTER_API_RESULT& aResult )
+{
+    if( !apiBegin( -1, aResult ) )
+        return false;
+
+    if( aEffort <= 0 )
+    {
+        aEffort = PNS::OPTIMIZER::MERGE_SEGMENTS | PNS::OPTIMIZER::SMART_PADS
+                  | PNS::OPTIMIZER::MERGE_OBTUSE;
+    }
+
+    if( aKeepTopology )
+        aEffort |= PNS::OPTIMIZER::KEEP_TOPOLOGY;
+
+    PNS::NODE* branch = m_router->GetWorld()->Branch();
+    int        changed = 0;
+    int        lines = 0;
+
+    for( NETINFO_ITEM* net : aNets )
+    {
+        std::set<PNS::ITEM*> items;
+        branch->AllItemsInNet( net, items, PNS::ITEM::SEGMENT_T | PNS::ITEM::ARC_T );
+
+        // Pointers in 'items' may be freed once their line is replaced, so remember the
+        // already-processed ones and never dereference them again.
+        std::set<PNS::ITEM*> done;
+
+        for( PNS::ITEM* item : items )
+        {
+            if( done.count( item ) )
+                continue;
+
+            PNS::LINKED_ITEM* li = static_cast<PNS::LINKED_ITEM*>( item );
+            PNS::LINE         line = branch->AssembleLine( li );
+
+            bool locked = false;
+            bool inArea = !aArea;
+
+            for( PNS::LINKED_ITEM* link : line.Links() )
+            {
+                done.insert( link );
+                locked |= link->IsLocked();
+
+                if( aArea && ( aArea->Contains( link->Anchor( 0 ) ) || aArea->Contains( link->Anchor( 1 ) ) ) )
+                    inArea = true;
+            }
+
+            if( locked || !inArea || line.SegmentCount() < 1 )
+                continue;
+
+            lines++;
+
+            PNS::LINE optimized( line );
+
+            if( PNS::OPTIMIZER::Optimize( &optimized, aEffort, branch ) )
+            {
+                if( optimized.CLine().CompareGeometry( line.CLine() ) )
+                    continue;
+
+                optimized.ClearLinks();
+                branch->Replace( line, optimized );
+                changed++;
+            }
+        }
+    }
+
+    aResult.completed = true;
+    aResult.message = wxString::Format( wxT( "%d of %d lines optimized" ), changed, lines );
+
+    if( changed && !aDryRun )
+    {
+        m_router->CommitRouting( branch );
+        aResult.committed = true;
+    }
+
+    apiEnd();
+    return true;
+}
+
+
+static wxString apiItemKind( const PNS::ITEM* aItem )
+{
+    switch( aItem->Kind() )
+    {
+    case PNS::ITEM::SOLID_T:
+    {
+        BOARD_ITEM* parent = aItem->Parent();
+
+        if( !parent )
+            return wxT( "solid" );
+
+        switch( parent->Type() )
+        {
+        case PCB_PAD_T:  return wxT( "pad" );
+        case PCB_ZONE_T: return static_cast<ZONE*>( parent )->GetIsRuleArea() ? wxT( "keepout" ) : wxT( "zone" );
+        default:         return parent->GetLayer() == Edge_Cuts ? wxT( "outline" ) : wxT( "graphic" );
+        }
+    }
+    case PNS::ITEM::VIA_T:     return wxT( "via" );
+    case PNS::ITEM::SEGMENT_T: return wxT( "track" );
+    case PNS::ITEM::ARC_T:     return wxT( "arc" );
+    case PNS::ITEM::HOLE_T:    return wxT( "hole" );
+    default:                   return wxT( "item" );
+    }
+}
+
+
+static wxString apiItemDescription( BOARD_ITEM* aParent )
+{
+    if( !aParent )
+        return wxEmptyString;
+
+    if( aParent->Type() == PCB_PAD_T )
+    {
+        PAD* pad = static_cast<PAD*>( aParent );
+
+        if( FOOTPRINT* fp = pad->GetParentFootprint() )
+            return fp->GetReference() + wxT( "." ) + pad->GetNumber();
+
+        return wxT( "pad " ) + pad->GetNumber();
+    }
+
+    if( aParent->Type() == PCB_ZONE_T )
+        return static_cast<ZONE*>( aParent )->GetZoneName();
+
+    if( FOOTPRINT* fp = aParent->GetParentFootprint() )
+        return fp->GetReference();
+
+    return wxEmptyString;
+}
