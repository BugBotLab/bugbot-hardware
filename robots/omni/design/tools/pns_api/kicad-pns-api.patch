diff --git a/api/proto/board/router_commands.proto b/api/proto/board/router_commands.proto
new file mode 100644
index 00000000..5c45dc62
--- /dev/null
+++ b/api/proto/board/router_commands.proto
@@ -0,0 +1,331 @@
+/*
+ * This program source code file is part of KiCad, a free EDA CAD application.
+ *
+ * Private extension (BugBot tooling): scripted access to the interactive
+ * push-and-shove router (PNS).  Not part of upstream KiCad.
+ *
+ * This program is free software: you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or (at your
+ * option) any later version.
+ */
+
+syntax = "proto3";
+
+package kiapi.board.commands;
+
+import "common/types/base_types.proto";
+import "board/board_types.proto";
+
+enum RouterMode
+{
+  RTM_UNKNOWN    = 0;   // use the router's current setting
+  RTM_SHOVE      = 1;   // push-and-shove
+  RTM_WALKAROUND = 2;   // walk around obstacles
+  RTM_HIGHLIGHT  = 3;   // highlight collisions (mark obstacles); never moves other items
+}
+
+message RouteWaypoint
+{
+  kiapi.common.types.Vector2 position = 1;
+
+  // Layer to continue on from this point.  BL_UNKNOWN keeps the current layer.
+  // A change of layer places a via at this waypoint.
+  kiapi.board.types.BoardLayer layer = 2;
+}
+
+// Routes one track through the given waypoints with the interactive router, exactly as if
+// the user had clicked at each point with the router tool, and commits the result.
+// The first waypoint is the start (should be on a pad, track end or via of the net).
+message RouteTrack
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+
+  // Net name.  Optional if the start point is on a connected item.
+  string net = 2;
+
+  repeated RouteWaypoint points = 3;
+
+  // Start layer.  BL_UNKNOWN = layer of the item under the start point.
+  kiapi.board.types.BoardLayer layer = 4;
+
+  // Track width; 0 = use the net class / design rules.
+  kiapi.common.types.Distance width = 5;
+
+  // Via size for layer changes; 0 = use the net class / design rules.
+  kiapi.common.types.Distance via_diameter = 6;
+  kiapi.common.types.Distance via_drill = 7;
+
+  RouterMode mode = 8;
+
+  // If false (default), the route is discarded unless the last waypoint is reached.
+  bool allow_partial = 9;
+
+  // If true, do not commit; just report what would happen.
+  bool dry_run = 10;
+
+  // The router is fed intermediate cursor positions this far apart between waypoints (like mouse
+  // motion), so shoved items are pushed gradually instead of being jumped over.  0 = 0.1 mm.
+  kiapi.common.types.Distance step = 11;
+
+  // Route the net and its coupled net (USB_DP/USB_DN, X_P/X_N, X+/X-) as a differential pair.
+  // The waypoints are the pair's centreline; width is the pair's track width.
+  bool diff_pair = 12;
+  kiapi.common.types.Distance diff_pair_gap = 13;   // 0 = net class / rules
+}
+
+message RouterItemChange
+{
+  kiapi.common.types.KIID id = 1;
+  string type = 2;    // "track", "arc", "via"
+  string net = 3;
+}
+
+message RouterResult
+{
+  bool committed = 1;
+
+  // True when the route reached the last waypoint (or the drag reached the target).
+  bool completed = 2;
+
+  // Where the routed head actually ended.
+  kiapi.common.types.Vector2 reached = 3;
+
+  string message = 4;
+
+  repeated RouterItemChange added = 5;
+  repeated RouterItemChange removed = 6;
+  repeated RouterItemChange modified = 7;   // existing items moved (shoved)
+}
+
+// Drags a track segment or via with the router (shove / walkaround / highlight).
+message DragItem
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+
+  kiapi.common.types.KIID item = 2;
+
+  // Point on the item where it is grabbed.  Unset = the via centre / segment midpoint.
+  kiapi.common.types.Vector2 grab = 3;
+
+  kiapi.common.types.Vector2 target = 5;
+
+  RouterMode mode = 6;
+
+  // Free-angle drag (default: 45 degree drag, same as the 'D' hotkey).
+  bool free_angle = 7;
+
+  // Commit even if the result violates DRC (only meaningful in highlight mode).
+  bool force = 8;
+
+  bool dry_run = 9;
+
+  // Cursor step between grab and target (see RouteTrack.step).  0 = 0.1 mm.
+  kiapi.common.types.Distance step = 10;
+}
+
+// Runs the PNS optimizer (corner merging, pad-exit cleanup) over all tracks of the given nets.
+message OptimizeNets
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+
+  repeated string nets = 2;
+
+  // OPTIMIZER effort flags; 0 = MERGE_SEGMENTS | SMART_PADS | MERGE_OBTUSE.
+  int32 effort = 3;
+
+  bool keep_topology = 4;
+
+  bool dry_run = 5;
+
+  // Only lines with a segment inside this box are optimized; with an area and no nets, every net
+  // with tracks in the area is optimized.
+  kiapi.common.types.Box2 area = 6;
+}
+
+
+/*
+ * Phase 2: analysis and editing helpers
+ */
+
+message GetUnrouted
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+  repeated string nets = 2;     // empty = all nets
+}
+
+message UnroutedEndpoint
+{
+  kiapi.common.types.Vector2 position = 1;
+  kiapi.board.types.BoardLayer layer = 2;     // first copper layer of the item
+  kiapi.common.types.KIID item = 3;
+  string type = 4;                            // pad, via, track, arc, zone
+  string description = 5;                     // e.g. "U6.48"
+  repeated kiapi.board.types.BoardLayer layers = 6;   // copper layers of the item
+}
+
+message UnroutedLink
+{
+  string net = 1;
+  UnroutedEndpoint a = 2;
+  UnroutedEndpoint b = 3;
+  int64 length_nm = 4;
+}
+
+message UnroutedResponse
+{
+  repeated UnroutedLink links = 1;
+  int32 unconnected_count = 2;
+}
+
+enum ProbeKind
+{
+  PK_UNKNOWN = 0;
+  PK_POINT   = 1;   // a round dot of 'width' at 'start' on 'layer' (a track end)
+  PK_SEGMENT = 2;   // a track from 'start' to 'end'
+  PK_VIA     = 3;   // a through via at 'start'
+}
+
+// Would this track / via pass the router's clearance rules here, and how far is the nearest
+// obstacle?  Uses the router's own collision model (same rules as interactive routing:
+// tracks, vias, pads, holes, keepouts, board edge; zone fills are not obstacles).
+message ProbeClearance
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+  ProbeKind kind = 2;
+  kiapi.common.types.Vector2 start = 3;
+  kiapi.common.types.Vector2 end = 4;
+  kiapi.board.types.BoardLayer layer = 5;
+  string net = 6;                                   // the probe's net ("" = no net)
+  kiapi.common.types.Distance width = 7;            // 0 = net class
+  kiapi.common.types.Distance via_diameter = 8;     // 0 = rules
+  kiapi.common.types.Distance via_drill = 9;
+  kiapi.common.types.Distance search_radius = 10;   // 0 = 1 mm
+  int32 max_results = 11;                           // 0 = 10
+}
+
+message ProbeObstacle
+{
+  string kind = 1;          // pad, via, track, arc, hole, outline, keepout, ...
+  string net = 2;
+  kiapi.common.types.KIID item = 3;
+  string description = 4;
+  int64 distance_nm = 5;    // copper-to-copper gap
+  int64 required_nm = 6;    // clearance the rules ask for
+  int64 margin_nm = 7;      // distance - required (negative = violation)
+  kiapi.board.types.BoardLayer layer = 8;
+}
+
+message ProbeResult
+{
+  bool ok = 1;              // no collision under the rules
+  int64 min_margin_nm = 2;  // smallest margin over the obstacles found (search_radius if none)
+  repeated ProbeObstacle obstacles = 3;   // nearest first
+  string message = 4;
+}
+
+message GetZoneIslands
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+  repeated string nets = 2;     // empty = all copper zones
+}
+
+message ZoneIslandItem
+{
+  kiapi.common.types.KIID item = 1;
+  string type = 2;
+  string description = 3;
+}
+
+message ZoneIsland
+{
+  kiapi.common.types.KIID zone = 1;
+  string zone_name = 2;
+  string net = 3;
+  kiapi.board.types.BoardLayer layer = 4;
+  int32 index = 5;                 // outline index in the zone's fill on that layer
+  double area_mm2 = 6;
+  kiapi.common.types.Box2 bbox = 7;
+  bool isolated = 8;               // not connected to any pad of the net
+  bool single_connection = 9;
+  repeated ZoneIslandItem direct = 10;   // items touching this island
+  int32 cluster_pads = 11;               // pads reachable through this island
+  repeated string pads = 12;             // their names (first 30)
+  kiapi.common.types.Vector2 anchor = 13;  // a point inside the island
+}
+
+message ZoneIslandsResponse
+{
+  repeated ZoneIsland islands = 1;
+}
+
+message SetTeardrops
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+  bool enable = 2;              // false removes them
+  bool vias = 3;
+  bool pth_pads = 4;
+  bool smd_pads = 5;
+  bool track_to_track = 6;
+  repeated string nets = 7;     // empty = all
+}
+
+message TeardropsResponse
+{
+  int32 items_changed = 1;
+  int32 teardrop_zones = 2;
+}
+
+// Same as Tools > Update PCB from Schematic, from a KiCad netlist file
+// (kicad-cli sch export netlist --format kicadsexpr), so it works in stand-alone pcbnew.
+message UpdateFromNetlist
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+  string netlist_path = 2;
+  bool dry_run = 3;
+  bool relink_by_reference = 4;   // default false = match by symbol UUID
+  bool delete_unused_footprints = 5;
+  bool replace_footprints = 6;    // footprints whose lib id changed
+  bool update_fields = 7;
+  bool override_locks = 8;
+}
+
+message UpdateFromNetlistResponse
+{
+  bool applied = 1;
+  string report = 2;
+  int32 errors = 3;
+  int32 warnings = 4;
+}
+
+enum TuneMode
+{
+  TM_UNKNOWN = 0;
+  TM_SINGLE = 1;
+  TM_DIFF_PAIR = 2;
+  TM_DIFF_PAIR_SKEW = 3;
+}
+
+// Adds a tuning pattern (meanders) on a track, like the length tuning tool: from 'start' to 'end'
+// along the track the router places meanders to reach the target.
+message TuneLength
+{
+  kiapi.common.types.DocumentSpecifier board = 1;
+  kiapi.common.types.KIID item = 2;            // a track segment of the net
+  kiapi.common.types.Vector2 start = 3;
+  kiapi.common.types.Vector2 end = 4;
+  TuneMode mode = 5;
+  kiapi.common.types.Distance target = 6;      // target length (or skew); 0 = rules
+  kiapi.common.types.Distance tolerance = 7;   // +- around target; 0 = 0.1 mm
+  kiapi.common.types.Distance max_amplitude = 8;
+  kiapi.common.types.Distance spacing = 9;
+  bool dry_run = 10;
+}
+
+message TuneLengthResult
+{
+  bool committed = 1;
+  string status = 2;          // tuned, too_short, too_long
+  int64 length_nm = 3;        // tuned length (or skew) reported by the tuner
+  string message = 4;
+}
